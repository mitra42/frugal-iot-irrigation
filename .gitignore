# PlatformIO build output and downloaded dependencies
.pio/
.pioenvs/
.piolibdeps/

# The library. Two ways to get it, neither of them committed here:
#   - PlatformIO downloads it into .pio/libdeps from the lib_deps line in platformio.ini
#   - a developer working on the library too puts a SYMLINK here, which takes precedence:
#       ln -s ../../frugal-iot-demo/lib/Frugal-IoT lib/Frugal-IoT
lib/

# Arduino IDE build output
build/

# Secrets. data/ is uploaded to the device's filesystem and holds WiFi passwords -
# see data/README.md. Nothing under it belongs in a public repository.
data/wifi/
data/frugal_iot/

# Settings for one checkout, loaded by "extra_configs = *-local.ini" in platformio.ini:
# platformio-local.ini (the local library, debug flags - see "Building against a local library" in
# CLAUDE.md) and platformio-secrets-local.ini (the enrolment secret, which server). Never committed.
# platform-secrets-local.h is the Arduino IDE form of the secrets - see the library's _settings.h.
*-local.ini
*-local.h

# Where scripts/release.zsh --build stages and collects the OTA builds
ota-stage/

# Editor and OS noise
.vscode/
.DS_Store
*.swp
