	(text "Valves MUST be NORMALLY CLOSED and must not be latching. Loss of 12 V then closes them mechanically, and that - not the firmware - is what guarantees a dead controller"
		(at 20.32 472.44 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "2f980c4b-ddd4-4ea0-8228-fe7c6cfca46b")
	)
	(text "cannot leave water running. A latching valve holds its last state and the firmware cannot drive one anyway."
		(at 20.32 475.84 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "b749e8e6-89bb-488a-be74-96e40ca58eea")
	)
	(text "PUMP and LOAD switch the low side of a 12 V device. For a MAINS pump or router, drive an external Sonoff from the frugal-iot server instead: nothing on this sheet is"
		(at 20.32 482.64 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "3cc2a692-3c32-4268-af86-e3c4ccf066a9")
	)
	(text "rated for mains, and mixing mains with low voltage raises the safety bar a long way beyond what this drawing covers."
		(at 20.32 486.04 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "7758f1ec-35ff-4d12-b966-a4bdc18cdfbd")
	)
