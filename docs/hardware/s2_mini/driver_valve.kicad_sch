	(embedded_fonts no)
	(text "ONE VALVE CHANNEL"
		(at 25.4 20.32 0)
		(effects
			(font
				(size 3.4 3.4)
			)
			(justify left)
		)
		(uuid "ca0746c9-22fc-47fd-9525-e2a943785e04")
	)
	(text "Drawn once here and used three times - see the root sheet."
		(at 25.4 29.21 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left)
		)
		(uuid "db06274c-472b-4305-a175-167114bf5c38")
	)
	(text "field wiring ->"
		(at 195.58 55.88 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "ae63a474-a7fb-452c-a7a4-f091321d177e")
	)
	(text "GPIO, +12 V and GND are the only connections that leave this sheet. Everything else is"
		(at 25.4 162.56 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "c3ed7772-ae72-4739-bbe0-f9b97a80d510")
	)
	(text "internal, which is why the root sheet can draw the whole channel as one block."
		(at 25.4 166.36 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "9b2ae92d-5f6c-473c-a164-9f6496a4342b")
	)
	(text "RPD (100k, gate to GND) is a SAFETY part, not decoration: ESP32 GPIOs float before setup()"
		(at 25.4 173.96 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "e268b2bf-3fb0-4968-8d3e-2d19a774f593")
	)
	(text "runs and through a reset or a brownout, and this resistor is what holds the output off"
		(at 25.4 177.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "a1b0f182-4db7-45c8-9abe-3e3b4b473753")
	)
	(text "across that window."
		(at 25.4 181.56 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "10c86fce-26d3-4cc7-a8df-c8e5e6d20659")
	)
	(text "Active HIGH is fixed by the firmware - Actuator_Digital::act() is a bare"
		(at 25.4 189.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "d1ebd2d1-3498-45dc-a3ea-662301647c25")
	)
	(text "digitalWrite(pin, value) with no invert flag. A low-side N-MOSFET is the natural match;"
		(at 25.4 192.96 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "a7a06f93-b88c-491b-8d11-bf166610bd08")
	)
	(text "most cheap opto-relay boards are active LOW and would invert every output."
		(at 25.4 196.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "36677c77-7c75-4088-a1e2-92c1757333d2")
	)
	(text "D clamps the inductive kick when the FET turns off. Cathode to +12 V - backwards, it is a"
		(at 25.4 204.36 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "f5d89c17-38b1-4b23-9294-d07395ee4fa5")
	)
	(text "short across the supply the moment the output goes on."
		(at 25.4 208.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "41efe967-6680-4ede-9ea5-4544cae076a6")
	)
	(text "The solenoid MUST be normally closed and must not be latching: loss of 12 V then shuts"
		(at 25.4 215.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "2b0c04b9-02ba-4683-ad67-62885e5511b3")
	)
	(text "it mechanically, and that is what makes a dead controller safe."
		(at 25.4 219.56 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "884aaa4e-f6c8-4f92-a3b5-bf0bd7248679")
	)
