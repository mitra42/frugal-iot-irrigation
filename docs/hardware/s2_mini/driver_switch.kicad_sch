		(uuid "8017f860-2f04-448e-8e7b-2725ab8ec7a6")
	)
	(text "across that window."
		(at 25.4 181.56 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "0a731cfb-8368-4cf1-b297-4921dfdc4719")
	)
	(text "Active HIGH is fixed by the firmware - Actuator_Digital::act() is a bare"
		(at 25.4 189.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "2717b24a-1660-4593-9514-97c4969dec22")
	)
	(text "digitalWrite(pin, value) with no invert flag. A low-side N-MOSFET is the natural match;"
		(at 25.4 192.96 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "6f1176a4-dfe0-4813-b42d-757d5c40d535")
	)
	(text "most cheap opto-relay boards are active LOW and would invert every output."
		(at 25.4 196.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "6bd76b5d-f9d8-4886-8f83-a78a448a5a71")
	)
	(text "D clamps the inductive kick when the FET turns off. Cathode to +12 V - backwards, it is a"
		(at 25.4 204.36 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "2acca9ee-10fd-4dfe-a7ce-12d7f73c0684")
	)
	(text "short across the supply the moment the output goes on."
		(at 25.4 208.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "358247b3-78a3-4924-b343-a593c84db94d")
	)
	(text "Switches the low side of a 12 V device. For a MAINS pump or router use an external"
		(at 25.4 215.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "2fdccc87-0288-4ac4-a8c5-5e50e881bb55")
	)
	(text "Sonoff - nothing here is rated for mains."
		(at 25.4 219.56 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "7088a280-07fc-4677-994e-808000591ba4")
	)
